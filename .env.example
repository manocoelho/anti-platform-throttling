# ---------------------------------------------------------------------------
# Anti-Platform Throttling - variaveis de ambiente
#
# Copie este arquivo para `.env` antes de subir o stack:
#     cp .env.example .env
#
# O `.env` nao e versionado (ver .gitignore). Este arquivo documenta cada
# variavel e serve como fonte unica de verdade sobre a configuracao.
# ---------------------------------------------------------------------------

# --- Aplicacao -------------------------------------------------------------
APT_ENV=development
APT_LOG_LEVEL=INFO
# Se true, o log sai em JSON (util para agregadores). False = legivel no terminal.
APT_LOG_JSON=true

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=apt
POSTGRES_PASSWORD=apt_local_password
POSTGRES_DB=apt
# Hostname `postgres` = nome do servico no docker-compose.
APT_DATABASE_URL=postgresql+asyncpg://apt:apt_local_password@postgres:5432/apt

# --- Redis (estado distribuido: buckets, breaker, feature flags) -----------
APT_REDIS_URL=redis://redis:6379/0

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_DEFAULT_USER=apt
RABBITMQ_DEFAULT_PASS=apt_local_password
APT_RABBITMQ_URL=amqp://apt:apt_local_password@rabbitmq:5672/

# --- Simulador de plataformas externas -------------------------------------
APT_PLATFORM_SIM_URL=http://platform-sim:9001

# --- Scheduler (dispatcher rodando como background task da API) ------------
# Intervalo entre ticks do dispatcher, em segundos.
APT_DISPATCH_TICK_SECONDS=1.0
# Quantas tarefas o dispatcher pode publicar por tick, por campanha (teto de seguranca).
APT_DISPATCH_MAX_BATCH=200

# --- Worker ----------------------------------------------------------------
# Quantas mensagens o RabbitMQ entrega por vez a cada worker.
# prefetch=1 => load balancing justo entre workers (competing consumers).
APT_WORKER_PREFETCH=1
# Numero maximo de tentativas antes de mandar a mensagem para a DLQ.
APT_MAX_ATTEMPTS=4
# Timeout do envio HTTP as plataformas, em segundos.
APT_SEND_TIMEOUT_SECONDS=5.0

# --- Rate limiter (token bucket distribuido) -------------------------------
# Capacidade do bucket = tamanho maximo da rajada permitida.
# Refill rate = vazao sustentada em requisicoes por segundo.
#
# BURST calibrado pela formula burst + rps <= limite_da_plataforma, nao por
# "deliberadamente abaixo" sem numero: no pior caso (bucket cheio + refill do
# mesmo segundo), uma unica janela de 1s do simulador ve burst+rps
# requisicoes. YouTube: 1+3=4 <= 5. Instagram: 1+8=9 <= 10. O teto exato
# seria burst=2 em ambas -- usamos um a menos para ter margem real numa demo
# ao vivo (ver src/apt/domain/platforms.py e TRADE-OFFS.md item 16).
#
# YOUTUBE calibrado ABAIXO do teto de vazao agregada da VM de teste (~6-8
# req/s), e nao apenas abaixo do limite estimado da plataforma -- sem isso o
# rate limiter nunca chega a ser o gargalo observado, porque o hardware do
# ambiente limita primeiro. Ver a nota "RECALIBRACAO DO YOUTUBE" em
# src/apt/domain/platforms.py e TRADE-OFFS.md. O Instagram NAO mudou.
APT_RL_YOUTUBE_RPS=3.0
APT_RL_YOUTUBE_BURST=1
APT_RL_INSTAGRAM_RPS=8.0
APT_RL_INSTAGRAM_BURST=1
# Limite por conteudo (URL), para nao concentrar todo o volume numa unica URL.
APT_RL_PER_CONTENT_RPS=4.0
APT_RL_PER_CONTENT_BURST=4

# --- Circuit breaker -------------------------------------------------------
# Falhas consecutivas (ou 429/5xx) para abrir o circuito.
APT_CB_FAILURE_THRESHOLD=5
# Tempo que o circuito fica aberto antes de tentar half-open, em segundos.
APT_CB_OPEN_SECONDS=15
# Quantas sondas simultaneas o half-open permite.
APT_CB_HALF_OPEN_PROBES=2
# Sucessos consecutivos em half-open para fechar o circuito.
APT_CB_SUCCESS_THRESHOLD=3

# --- Bulkhead (isolamento por plataforma) ----------------------------------
# Envios simultaneos permitidos por plataforma, dentro de cada worker.
APT_BULKHEAD_YOUTUBE=8
APT_BULKHEAD_INSTAGRAM=4
# Tempo maximo esperando uma vaga no bulkhead antes de recusar (fail fast).
APT_BULKHEAD_ACQUIRE_TIMEOUT=2.0

# --- Retry -----------------------------------------------------------------
APT_RETRY_BASE_MS=500
APT_RETRY_MAX_MS=120000

# --- Simulador: thresholds "reais" das plataformas -------------------------
# O simulador devolve 429 quando estes limites sao excedidos.
# Sao ESTIMATIVAS para ambiente controlado, nao numeros oficiais das
# plataformas (ver docs/adr/ADR-008-simulador-de-plataformas.md).
#
# NOTA: estas duas variaveis sao documentacao, nao configuracao viva -- a
# classe `Settings` (src/apt/config.py) nao declara os campos
# `sim_youtube_limit_rps`/`sim_instagram_limit_rps`, entao pydantic-settings
# as ignora silenciosamente (`extra="ignore"`). O limite que o simulador
# aplica de fato vem de `PLATFORM_PROFILES[platform].estimated_limit_rps` em
# src/apt/domain/platforms.py (ver `platform_sim/main.py::SimulatorState`).
# Mantemos os valores aqui sincronizados para nao confundir quem le o .env,
# mas mudar SO estas linhas nao muda o comportamento do simulador.
APT_SIM_YOUTUBE_LIMIT_RPS=5
APT_SIM_INSTAGRAM_LIMIT_RPS=10
# Latencia artificial do simulador, em milissegundos (min-max).
APT_SIM_LATENCY_MIN_MS=5
APT_SIM_LATENCY_MAX_MS=40
